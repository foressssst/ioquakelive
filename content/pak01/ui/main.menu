#include "ui/menudef.h"

{
    assetGlobalDef {
        font            "fonts/font" 16
        smallFont       "fonts/smallfont" 12
        bigFont         "fonts/bigfont" 20
        cursor          "ui/assets/3_cursor3"
        gradientBar     "ui/assets/gradientbar2.tga"
        itemFocusSound  "sound/misc/menu2.wav"
        fadeClamp       1.0
        fadeCycle       1
        fadeAmount      0.1
        shadowColor     0.1 0.1 0.1 0.25
    }

    // =============================================
    // MAIN TITLE SCREEN
    // =============================================
    // The front end: one owner-draw, drawn by code/ui/ui_home.c the way retail's
    // browser draws it. The items that follow are what the old menu had; they stay
    // out of the way at negative coordinates so the bindings that name them still
    // resolve, and nothing of them shows.
    menuDef {
        name "main"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_TRUE
        focusColor 1 .75 0 1
        popup

        onOpen {
            uiScript stopRefresh ;
            uiScript loadGameInfo ;
            uiScript homeOpen
        }

        onESC {
            open quit_popmenu
        }

        itemDef {
            name home
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 602 // UI_HOME
            rect -2000 -1000 4640 2480
            visible 1
        }

    }

    // =============================================
    // START MATCH
    // retail's web page; code/ui/ui_startmatch.c draws and runs it
    // =============================================
    menuDef {
        name "startmatch"
        background "ui/assets/backscreen_smoke"
        backgroundSize 0 0 1920 1080
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup // clicks beside the 4:3 area reach the page too

        onOpen { uiScript startMatchOpen }
        onESC { close startmatch ; open main }

        itemDef {
            name startmatch
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 600 // UI_STARTMATCH
            rect -2000 -1000 4640 2480
            visible 1
        }
    }

    // =============================================
    // SETTINGS
    // retail hands this to the web browser; code/ui/ui_settings.c draws and runs it
    // =============================================
    menuDef {
        name "settings"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup // clicks beside the 4:3 area reach the page too

        onOpen { uiScript settingsOpen }
        onESC { uiScript settingsClose }

        itemDef {
            name settings
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 601 // UI_SETTINGS
            rect -2000 -1000 4640 2480
            visible 1
        }
    }

    // The same page opened from inside a match. It has to be a menu of its own
    // because it must NOT be fullscreen: a fullscreen menu tells the client to
    // skip drawing the world, and the page is drawn over the match, tinted, the
    // way the browser did it. Declared fullscreen, what shows through the tint is
    // whatever was left in the buffer.
    menuDef {
        name "settings_ingame"
        fullScreen 0
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup

        onOpen { uiScript settingsOpen }
        onESC { uiScript settingsClose }

        itemDef {
            name settings
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 601 // UI_SETTINGS
            rect -2000 -1000 4640 2480
            visible 1
        }
    }
}
