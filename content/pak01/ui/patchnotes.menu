#include "ui/menudef.h"

// [ioquakelive] Patch Notes.
//
// A page retail does not have. It reads changelog.txt and lays it out the way
// quakeclub.com lays out its own patch notes: the versions in a column on the
// left, the one that is open beside it. code/ui/ui_patchnotes.c draws and runs
// it, under the same bar as the rest of the front end.

{
    menuDef {
        name "patchnotes"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup // clicks beside the 4:3 area reach the page too

        onOpen { uiScript patchNotesOpen }
        onESC { close patchnotes ; open main }

        itemDef {
            name patchnotes
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 605 // UI_PATCHNOTES
            rect -2000 -1000 4640 2480
            visible 1
        }
    }
}
