#include "ui/menudef.h"

// [ioquakelive] Credits.
//
// Who made what this is built on. code/ui/ui_credits.c draws and runs it, under
// the same bar as the rest of the front end, and it reads credits.txt.

{
    menuDef {
        name "credits"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup // clicks beside the 4:3 area reach the page too

        onOpen { uiScript creditsOpen }
        onESC { close credits ; open main }

        itemDef {
            name credits
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 606 // UI_CREDITS
            rect -2000 -1000 4640 2480
            visible 1
        }
    }
}
