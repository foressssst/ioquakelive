        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup

        onOpen { uiScript statsOpen }
        onESC { close stats ; open main }

        itemDef {
            name stats
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 606
            rect -2000 -1000 4640 2480
            visible 1
        }
    }

    menuDef {
        name "legal"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup

        onOpen { uiScript legalOpen }
        onESC { close legal ; open main }

        itemDef {
            name legal
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 608
            rect -2000 -1000 4640 2480
            visible 1
        }
    }

    menuDef {
        name "matches"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup

        onOpen { uiScript matchesOpen }
        onESC { close matches ; open main }

        itemDef {
            name matches
            type ITEM_TYPE_OWNERDRAW
