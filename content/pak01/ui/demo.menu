#include "ui/menudef.h"

// [QL] Replays.
//
// Overrides pak00's ui/demo.menu, which is the pre-browser list with its framed
// box and FEEDER_DEMOS listbox. Retail's own page is /stats/demos in the web UI:
// an h1 and a list of the files, where clicking one sends `demo "<file>"`.
// code/ui/ui_replays.c draws and runs that, under the same bar as the rest.

{
    menuDef {
        name "demo"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        popup // clicks beside the 4:3 area reach the page too

        onOpen { uiScript replaysOpen }
        onESC { close demo ; open main }

        itemDef {
            name replays
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 603 // UI_REPLAYS
            rect -2000 -1000 4640 2480
            visible 1
        }
    }
}
