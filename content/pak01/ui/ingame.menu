#include "ui/menudef.h"

// [QL] The in-game menu.
//
// Overrides pak00's ui/ingame.menu, which is the bar of seven buttons and the
// four panels under it. What each of them does is kept command for command in
// code/ui/ui_pause.c, which draws the same menu in the language the rest of the
// front end uses. The panels ui/ingame_{about,callvote,admin,addbot}.menu are
// still in pak00 and still load; nothing opens them any more.
//
// Main Menu and Settings both handed the screen to the browser in retail. Settings
// has a page of its own here, and there is no browser to go home to, so the bar
// carries Settings and Leave Match and nothing else on its right.

{
    menuDef {
        name "ingame"
        fullScreen 0
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 0.964 0.815 0 1
        popup // clicks beside the 4:3 area reach the page too

        onOpen { uiScript pauseOpen }
        onESC { uiScript closeingame }

        itemDef {
            name pause
            type ITEM_TYPE_OWNERDRAW
            ownerdraw 604 // UI_PAUSE
            rect -2000 -1000 4640 2480
            visible 1
        }
    }
}
